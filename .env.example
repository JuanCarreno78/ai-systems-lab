# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# Proveedor: groq | openrouter | openai | deepseek | ollama | fake
#   groq y openrouter tienen plan gratuito; openai y deepseek requieren saldo (de pago)
#   ollama: modelo local (http://localhost:11434/v1); LLM_API_KEY puede ser cualquier valor, p. ej. "ollama"
#   fake:   proveedor falso para pruebas, no llama a ninguna API (reto opcional)
LLM_PROVIDER=groq

# API key del proveedor elegido
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
#   OpenAI:     https://platform.openai.com/api-keys
#   DeepSeek:   https://platform.deepseek.com/api_keys
LLM_API_KEY=

# Modelo (verifica la lista vigente en la consola del proveedor)
#   Groq:       llama-3.3-70b-versatile
#   OpenRouter: google/gemma-4-31b-it:free   (los modelos ":free" cambian; revisa openrouter.ai/models)
#   OpenAI:     gpt-4.1-mini
#   DeepSeek:   deepseek-chat
#   Ollama:     qwen3:8b (o el que tengas en `ollama list`)
LLM_MODEL=llama-3.3-70b-versatile

# Parámetros por defecto del modelo
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# Opcional. Para modelos que "piensan" antes de responder: con qwen3 en Ollama se usó "none"
# y con nex-n2.5-pro en OpenRouter "low". Vacío para los demás modelos.
LLM_REASONING_EFFORT=
