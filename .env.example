# Plantilla del archivo .env que usa config.py.
# El .env real tiene la clave de la API, por eso no está en el repositorio (está en .gitignore).

# Configuración usada en las pruebas 1 a 7: modelo local con Ollama.
# Ollama no revisa la clave, así que se puso el texto "ollama".
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
# qwen3 "piensa" antes de responder y eso gastaba los tokens; con "none" se desactiva.
LLM_REASONING_EFFORT=none

# Configuración usada en la prueba 8: OpenRouter (la clave se crea en https://openrouter.ai/keys).
# El modelo que sugería el laboratorio (meta-llama/llama-3.3-70b-instruct:free) ya no estaba disponible.
# Los modelos gratuitos de OpenRouter cambian seguido: el 28 de septiembre nex-n2.5-pro dejó de ser
# gratuito y se probó que liquid/lfm-2.5-2.6b:free funcionaba con el chatbot y con structured.py.
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_MODEL=nex-agi/nex-n2.5-pro:free
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1024
# LLM_REASONING_EFFORT=low

# Otros proveedores que acepta config.py: groq, openai, deepseek y fake (cliente falso del reto opcional).
