# Plantilla del .env. El .env real tiene la clave de la API y no se sube (está en .gitignore).

# Ollama, modelo local (pruebas 1 a 7). No revisa la clave.
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
# "none" desactiva el razonamiento de qwen3, que gastaba los max_tokens.
LLM_REASONING_EFFORT=none

# OpenRouter (prueba 8). Clave en https://openrouter.ai/keys
# Los modelos gratuitos cambian seguido: nex-n2.5-pro se usó en la prueba 8 y dejó de ser
# gratuito el 28 de septiembre; liquid/lfm-2.5-2.6b:free funcionaba en esa fecha.
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_MODEL=liquid/lfm-2.5-2.6b:free
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1024
# LLM_REASONING_EFFORT=low

# Otros proveedores de config.py: groq, openai, deepseek y fake (cliente falso para pruebas).

# --- Lab 02 (RAG) -----------------------------------------------------------
# Opcionales: si no se definen se usan estos valores.
# Después de cambiar EMBEDDING_MODEL o RAG_CHUNK_*, vuelve a ejecutar ingest.py.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_SIZE=80
RAG_CHUNK_OVERLAP=20
RAG_TOP_K=4
# 0.40: las preguntas del curso dieron 0.49 o más y las que no son del curso 0.347 o menos (Paso 6).
RAG_MIN_SCORE=0.40

# --- Examen final (Telegram y acceso por rostro) ----------------------------
# Token del bot de @BotFather: es un secreto, igual que la API key.
TELEGRAM_BOT_TOKEN=
# Similitud coseno mínima entre el rostro y el usuario enrolado (justificada con la tabla FAR/FRR).
FACE_MATCH_THRESHOLD=0.363
SESSION_MINUTES=10
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MINUTES=5
LIVENESS_TIMEOUT_SECONDS=60
